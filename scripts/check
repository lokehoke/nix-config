#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
python3 scripts/check-secrets.py
nix flake check --no-build
for profile in lokehoke lokehoke-minimal lokehoke-audio; do
  nix eval --raw ".#homeConfigurations.\"$profile\".activationPackage.drvPath" >/dev/null
done
# AI is optional; evaluate it explicitly as well.
nix eval --raw --expr \
  '(let f = builtins.getFlake (toString ./.); in (f.homeConfigurations.lokehoke-minimal.extendModules { modules = [{ my.ai.enable = true; }]; }).activationPackage.drvPath)' \
  --impure >/dev/null
